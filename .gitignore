# ---------------------------------------------------------------------------
# Large data artefacts -- regenerable, see "Data availability" in README.md
# ---------------------------------------------------------------------------

# Raw sequencing data (649 MB) -- NCBI SRA accession SRR26872904
SRR26872904.fasta/
*.fasta
*.fastq
*.fasta.gz
*.fastq.gz

# Reference databases (245 MB) -- auto-downloaded by `python main.py assign`
data/reference/

# Embeddings and subsets (2.6 GB) -- regenerated by `python main.py encode baseline`
outputs/embeddings/

# Per-read metadata table (20 MB) -- regenerated by `python main.py preprocess`
outputs/metrics/read_metadata.parquet
*.parquet

# ---------------------------------------------------------------------------
# Kept deliberately: outputs/figures, outputs/metrics/*.json, outputs/reports
# so every result is inspectable without re-running the pipeline.
# ---------------------------------------------------------------------------

# Source paper (copyrighted; see arXiv:2605.28868)
*.pdf
_paper.txt

